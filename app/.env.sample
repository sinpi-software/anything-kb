# Server-only: base URL the RR8 loaders use to reach the FastAPI backend
# in-cluster. Loaders forward the incoming request's Cookie header to this
# URL for session-gated reads (getMe, keys list) — never proxy Set-Cookie
# back through it. Client-side mutations always hit relative /api/... on
# the same origin instead.
INTERNAL_API_URL=http://ingestion-api.ingestion.svc.cluster.local:80

# Local dev override, if the backend is running outside the cluster:
# INTERNAL_API_URL=http://localhost:8000
